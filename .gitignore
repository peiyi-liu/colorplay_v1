# 設計 hook 快取（工具產生）
.impeccable/
artifacts/content/

# review gate 狀態檔（hook 產生）
.claude/review-gate/

# 個人機器層設定（enabledPlugins、個人 permission 覆寫），不共用
.claude/settings.local.json

# 工具快取／本機 plugin 狀態，不共用
.playwright-mcp/
.pnpm-store/
.remember/

# 舊設計參考資料，保留在本機但不進版控
/live/
/live-v2/

# blook 角色原始高畫質素材（production 用的縮圖在 public/assets/blooks/）
/blook-art-originals/

# git worktree 本體（每個都是完整 checkout，數 GB 起跳，絕不能進版控）
/.worktrees/
/.claude/worktrees/

# 設計比對截圖／參考圖，只做路徑紀錄用，不進版控（batch3／batch4 是既有例外，維持已追蹤狀態）
artifacts/design-audit/*
!artifacts/design-audit/batch3/
!artifacts/design-audit/batch4/
artifacts/ref/
