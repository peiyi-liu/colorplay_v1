{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colorplayapp.com/schemas/backup-manifest.schema.json",
  "title": "ColorPlay encrypted backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "artifact_kind",
    "project_ref",
    "repo_sha",
    "migration_first",
    "migration_last",
    "created_at_utc",
    "cli_versions",
    "dump_files",
    "storage",
    "age_recipient_fingerprint",
    "b2_prefix",
    "object_lock_expires_at_utc",
    "lifecycle_policy_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "const": "production" },
    "artifact_kind": { "enum": ["production", "synthetic_fixture"] },
    "project_ref": { "type": "string", "pattern": "^[a-z]{20}$" },
    "repo_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "migration_first": {
      "type": "string",
      "pattern": "^[0-9]{14}(?:_[a-z0-9_]+)?(?:\\.sql)?$"
    },
    "migration_last": {
      "type": "string",
      "pattern": "^[0-9]{14}(?:_[a-z0-9_]+)?(?:\\.sql)?$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "cli_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "b2", "pg_dump", "supabase"],
      "properties": {
        "age": { "type": "string", "minLength": 1 },
        "b2": { "type": "string", "minLength": 1 },
        "pg_dump": { "type": "string", "minLength": 1 },
        "supabase": { "type": "string", "minLength": 1 }
      }
    },
    "dump_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/].*\\.age$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_sha256", "object_count", "total_bytes"],
      "properties": {
        "inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "object_count": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "age_recipient_fingerprint": {
      "type": "string",
      "pattern": "^age1[a-z0-9]{10,}$"
    },
    "b2_prefix": { "type": "string", "pattern": "^production/.+/$" },
    "object_lock_expires_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "lifecycle_policy_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    }
  }
}
