{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colorplayapp.com/schemas/release-record.schema.json",
  "title": "ColorPlay production release record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "git_sha",
    "vercel_deployment_id",
    "vercel_deployment_url",
    "production_supabase_ref",
    "migration_first",
    "migration_last",
    "staging_gate_run_url",
    "production_gate_run_url",
    "approval_actor",
    "approval_at_utc",
    "post_deploy_smoke",
    "previous_healthy_deployment_id",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "vercel_deployment_id": {
      "type": "string",
      "pattern": "^dpl_[A-Za-z0-9]{8,}$"
    },
    "vercel_deployment_url": { "type": "string", "format": "uri" },
    "production_supabase_ref": { "type": "string", "pattern": "^[a-z]{20}$" },
    "migration_first": {
      "type": "string",
      "pattern": "^[0-9]{14}(?:_[a-z0-9_]+)?(?:\\.sql)?$"
    },
    "migration_last": {
      "type": "string",
      "pattern": "^[0-9]{14}(?:_[a-z0-9_]+)?(?:\\.sql)?$"
    },
    "staging_gate_run_url": { "type": "string", "format": "uri" },
    "production_gate_run_url": { "type": "string", "format": "uri" },
    "approval_actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
    },
    "approval_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "post_deploy_smoke": { "enum": ["passed", "failed"] },
    "previous_healthy_deployment_id": {
      "type": "string",
      "pattern": "^dpl_[A-Za-z0-9]{8,}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
